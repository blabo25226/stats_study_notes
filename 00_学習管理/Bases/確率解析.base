filters:
  and:
    - 'file.ext == "md"'
    - or:
        - 'file.inFolder("13_測度論・ルベーグ積分")'
        - 'file.inFolder("14_確率論・確率過程論")'
        - 'file.inFolder("15_確率微分方程式")'
properties:
  file.name:
    displayName: ノート
  stats-category:
    displayName: 分野
  difficulty:
    displayName: 難易度
  file.folder:
    displayName: フォルダ
views:
  - type: table
    name: 全体
    order:
      - file.name
      - file.folder
      - stats-category
      - difficulty
